* text=auto eol=lf

# Unity の資産。Unity の YAML のマージを使う
*.prefab merge=unityyamlmerge eol=lf
*.unity  merge=unityyamlmerge eol=lf
*.asset  merge=unityyamlmerge eol=lf
*.meta   merge=unityyamlmerge eol=lf

# UdonSharp の生成物。gzip のヘッダーの OS の byte を揃える filter は bin/setup-git で入れる
/Assets/SerializedUdonPrograms/*.asset filter=udon-gzip

# バイナリ
*.png  binary
*.jpg  binary
*.mp3  binary
*.wav  binary
*.ogg  binary
*.dll  binary
*.unitypackage binary
*.zip  binary
